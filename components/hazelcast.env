# com.hazelcast:hazelcast, upstream tag v5.7.0 (submodule hazelcast); only the
# hazelcast module is built.
SUBMODULE=hazelcast
VERSION=5.7.0-alauda-1
ARTIFACT=hazelcast
MODULE=hazelcast
MVN_ARGS="-DskipTests -Dcheckstyle.skip=true -Dspotbugs.skip=true"
EXPECT_SHADED="META-INF/maven/com.fasterxml.jackson.core/jackson-core/pom.properties=2.22.4 META-INF/maven/com.fasterxml.jackson.core/jackson-databind/pom.properties=2.22.4 META-INF/maven/tools.jackson.core/jackson-core/pom.properties=3.2.3 META-INF/maven/tools.jackson.core/jackson-databind/pom.properties=3.2.3"
# The version must match hazelcast's own version pattern
# (^\d+\.\d+(\.\d+)?(-\w+(-\d+)?)?(-SNAPSHOT)?$): it parses its build version at
# runtime as the cluster version, so "-alauda.1" fails and "-alauda-1" works.
